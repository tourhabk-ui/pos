{
  "name": "dsh-vedar",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin: Vedar (vedarai.ru) Kamchatka travel MCP server — tours and live availability, safety status of places and routes, stays, transfers, weather, trip plans. 堪察加旅游 MCP 服务器，一条命令接入 DeepSeek Harness。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh plugin",
    "deepseek-harness",
    "mcp",
    "model-context-protocol",
    "mcp-client",
    "kamchatka",
    "travel",
    "堪察加",
    "旅游"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "label": "dsh plugin"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-mcp-client": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-mcp-client": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tourhabk-ui/dsh-vedar.git"
  },
  "homepage": "https://vedarai.ru/mcp",
  "bugs": {
    "url": "https://github.com/tourhabk-ui/pos/issues"
  }
}
