# ===========================================
# KamchatourHub — Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values.
# Required vars are marked with [REQUIRED].
# All others are optional with sensible defaults.

# ── Core / Application ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000

# ── Database (PostgreSQL) [REQUIRED] ────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/database
DATABASE_SSL=false
DATABASE_MAX_CONNECTIONS=20
DATABASE_CONNECTION_TIMEOUT=2000
DATABASE_IDLE_TIMEOUT=30000

# ── Auth (JWT) [REQUIRED] ──────────────────────────────────────────
JWT_SECRET=your-jwt-secret-min-32-chars
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d

# ── Timeweb Cloud ──────────────────────────────────────────────────
TIMEWEB_TOKEN=your-timeweb-api-token
TIMEWEB_TOKEN1=
TIMEWEB_API_TOKEN=your-timeweb-api-token
TIMEWEB_AI_AGENT_ID=your-timeweb-ai-agent-id
TIMEWEB_AI_KB_ID=

# ── AI Providers (waterfall: OpenRouter → DeepSeek → Gemini → MiMo → YandexGPT → MiniMax → Anthropic)
# CRITICAL: At least one AI key must be set or Kuzmich returns "Извините, сервис недоступен"
# Check /api/ai/debug-waterfall?check=env to see which keys are configured
OPENROUTER_API_KEY=            # [REQUIRED] Main AI provider — openrouter.ai (supports claude-haiku, gpt-4o-mini, llama-free)
OPENROUTER_MANAGEMENT_KEY=     # Needed for balance check: OpenRouter → Settings → Management Keys
OR_API_KEY=                    # Alias for OPENROUTER_API_KEY (either works)
DEEPSEEK_API_KEY=              # DeepSeek direct — platform.deepseek.com (fallback)
GEMINI_API_KEY=                # Google Gemini 2.0 Flash — aistudio.google.com/apikey (free tier available!)
XIAOMI_API_KEY=                # Xiaomi MiMo-V2-Pro — xiaomimimo.com (fallback)
YANDEX_API_KEY=                # YandexGPT 5.1 — console.yandex.cloud (best for Russian)
YANDEX_FOLDER_ID=              # YandexGPT catalog ID (required with YANDEX_API_KEY)
MINIMAX_API_KEY=               # MiniMax API key (fallback)
MINIMAX_GROUP_ID=              # MiniMax Group ID (required with MINIMAX_API_KEY)
XAI_API_KEY=                   # xAI Grok (geo-blocked from Russia)
FUGU_API_KEY=                  # Sakana AI Fugu Ultra — api.sakana.ai (tier-1 race)
ANTHROPIC_API_KEY=             # Claude direct (geo-blocked from Russia, last resort)
NVIDIA_API_KEY=                # NVIDIA NIM — build.nvidia.com (free tier: Llama 3.3-70B)
GLM_API_KEY=                   # Zhipu GLM (fallback)
AI_MAX_TOKENS=800
AI_DAILY_BUDGET_USD=10.0

# ── Telegram: @kuzmichai_bot ─────────────────────────────────────────
# Единственный бот — и Кузьмич, и агенты, и уведомления
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_WEBHOOK_SECRET=your-webhook-secret
TELEGRAM_OWNER_ID=171286547              # Numeric Telegram user ID (личка)
TELEGRAM_CHAT_ID=171286547              # Scout-Innovator proposals, брони → личка
TELEGRAM_CHANNEL_ID=@kamchatka_real     # Kuzmich: туристический контент
TELEGRAM_AI_CHANNEL_ID=@ai_hub_money   # Scout-Digest: AI дайджест
TELEGRAM_ADMIN_BOT_TOKEN=              # Не используется (один бот)
TELEGRAM_ADMIN_CHAT_ID=               # SOS alerts (если отдельный чат, иначе = TELEGRAM_CHAT_ID)

# ── Telegram: Login Widget ──────────────────────────────────────────
# The public @username of the bot (without @)
# REQUIRED: run /setdomain → tourhab.ru in BotFather first
# Widget only renders on /auth/login when this var is set
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=KuzmichKam_bot

# ── Meta Business (Instagram DM + Messenger + WhatsApp) ────────────────
# Webhook: POST /api/meta/webhook (Instagram DM + Messenger)
# Setup: developers.facebook.com → App → Webhooks → Instagram/Messenger
# Catalog: GET /api/meta/catalog → Meta Commerce Manager → Data Sources
META_PAGE_ACCESS_TOKEN=          # Page Access Token из Meta Business Suite
META_VERIFY_TOKEN=your-verify-token  # Произвольная строка для верификации webhook
META_APP_ID=                     # App ID из developers.facebook.com
META_APP_SECRET=                 # App Secret (для валидации X-Hub-Signature-256)
# WhatsApp (existing):
WHATSAPP_ACCESS_TOKEN=           # Phone Number Access Token (может совпадать с META_PAGE_ACCESS_TOKEN)
WHATSAPP_PHONE_NUMBER_ID=        # ID номера WhatsApp Business
WHATSAPP_VERIFY_TOKEN=           # Verify token для WhatsApp webhook (может = META_VERIFY_TOKEN)

# ── MAX Messenger: Bot Kuzmich (ID4101147649) ───────────────────────
# Webhook: POST /api/max/kuzmich
# Polling: GET /api/max/kuzmich (for cron/dev)
# Channel: max.ru/id4101147549_biz
MAX_BOT_TOKEN=your-max-bot-token
MAX_CHANNEL_ID=-72338356401519
MAX_CHANNEL_LINK=https://max.ru/id4101147649_biz
TELEGRAM_CHANNEL_LINK=https://t.me/kamchatka_real

# ── Email (SMTP) ───────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=
EMAIL_FROM=noreply@kamchatour.ru

# ── SMS ────────────────────────────────────────────────────────────
SMS_RU_API_KEY=

# ── Payments ───────────────────────────────────────────────────────
# CloudPayments
CLOUDPAYMENTS_API_SECRET=your-cloudpayments-secret
NEXT_PUBLIC_CLOUDPAYMENTS_PUBLIC_ID=your-cloudpayments-public-id

# Yandex Payment
YANDEX_PAYMENT_SHOP_ID=
YANDEX_PAYMENT_SECRET_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Platform commission (0.0 to 1.0)
PLATFORM_COMMISSION_RATE=0.15

# ── Maps / Geocoding ──────────────────────────────────────────────
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=your-yandex-maps-js-api-key
YANDEX_MAPS_API_KEY=your-yandex-maps-server-api-key

# ── Weather APIs ───────────────────────────────────────────────────
OPENWEATHERMAP_API_KEY=
WEATHERAPI_KEY=
YANDEX_WEATHER_API_KEY=

# ── File Storage / S3 (Timeweb S3) ────────────────────────────────
FILE_MAX_SIZE=10485760
FILE_UPLOAD_PATH=/uploads
CDN_URL=
S3_ACCESS_KEY=your-s3-access-key
S3_SECRET_KEY=your-s3-secret-key
S3_ENDPOINT=https://s3.twcstorage.ru
S3_BUCKET=your-s3-bucket-name
S3_REGION=ru-1

# ── Redis ──────────────────────────────────────────────────────────
REDIS_URL=
REDIS_PASSWORD=
REDIS_DB=0

# Upstash Redis (for rate limiting in Edge middleware)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Partners ───────────────────────────────────────────────────────
KAMCHATKA_FISHING_API_KEY=
KAMCHATKA_FISHING_API_SECRET=

# ── Safety (MCHS integration) ─────────────────────────────────────
MCHS_API_URL=
MCHS_API_TOKEN=

# ── External Services ─────────────────────────────────────────────
# CRON_SECRET protects /api/cron/* endpoints — set in cron-job.org as ?secret=<CRON_SECRET>
CRON_SECRET=your-long-random-cron-secret
CREWAI_API_URL=http://localhost:8001
WEBHOOK_SECRET=
KNOWLEDGE_BASE_SOURCE_URLS=
MARKDOWN_NEW_ENDPOINT=

# ── Monitoring ─────────────────────────────────────────────────────
PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=9090

# ── CORS ───────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000

# ── Analytics / SEO ────────────────────────────────────────────────
GOOGLE_ANALYTICS_ID=
YANDEX_METRIKA_ID=
GOOGLE_SITE_VERIFICATION=
YANDEX_VERIFICATION=

# ── Development Flags ─────────────────────────────────────────────
MOCK_DATA=false
VERBOSE_LOGGING=false
