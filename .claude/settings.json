{
  "enabledPlugins": {
    "security-guidance@claude-plugins-official": true,
    "data@knowledge-work-plugins": true,
    "operations@knowledge-work-plugins": true,
    "customer-support@knowledge-work-plugins": true
  },
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(npx tsc:*)",
      "Bash(npx vitest:*)",
      "Bash(git :*)",
      "Bash(npm :*)",
      "Bash(ls:*)",
      "Bash(node --env-file=.env.local:*)",
      "Bash(python3:*)",
      "Bash(mkdir:*)",
      "Bash(env)",
      "Bash(npx eslint *)",
      "Bash(curl -s *)",
      "Bash(curl -s --max-time *)",
      "Bash(npm run dev*)",
      "Bash(npm run migrate*)",
      "Bash(DATABASE_URL=* npm run migrate*)",
      "WebFetch(domain:habr.com)",
      "WebFetch(domain:vc.ru)",
      "WebFetch(domain:developers.tochka.com)",
      "WebFetch(domain:enter.tochka.com)",
      "WebFetch(domain:kamchatkaland.ru)",
      "WebFetch(domain:spkam.com)",
      "WebFetch(domain:openstreetmap.org)",
      "WebFetch(domain:nominatim.openstreetmap.org)",
      "WebFetch(domain:idilesom.com)",
      "WebFetch(domain:visitkamchatka.ru)"
    ]
  },
  "mcpServers": {
    "postgres": {
      "command": "sh",
      "args": ["-c", "npx -y @modelcontextprotocol/server-postgres \"$DATABASE_URL\""],
      "env": {}
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "root=$(git rev-parse --show-toplevel 2>/dev/null); [ -f \"$root/CLAUDE.md\" ] || exit 0; result=$(cd \"$root\" && npx tsc --noEmit 2>&1); if echo \"$result\" | grep -q 'error TS'; then errcount=$(echo \"$result\" | grep -c 'error TS'); printf '{\"continue\": false, \"stopReason\": \"TypeScript: %s ошиб(ок). Исправь — npx tsc --noEmit\"}' \"$errcount\"; exit 2; fi",
            "if": "Bash(git commit*)",
            "timeout": 60,
            "statusMessage": "TypeScript проверка перед коммитом..."
          },
          {
            "type": "command",
            "command": "root=$(git rev-parse --show-toplevel 2>/dev/null); [ -f \"$root/CLAUDE.md\" ] || exit 0; bash \"$root/.claude/hooks/db-schema-check.sh\"",
            "if": "Bash(git commit*)",
            "timeout": 10,
            "statusMessage": "DB schema проверка..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // empty' 2>/dev/null); if [[ \"$f\" == *.ts ]] || [[ \"$f\" == *.tsx ]]; then root=$(git -C \"$(dirname \"$f\")\" rev-parse --show-toplevel 2>/dev/null); if [ -n \"$root\" ]; then result=$(cd \"$root\" && npx tsc --noEmit 2>&1); if echo \"$result\" | grep -q 'error TS'; then n=$(echo \"$result\" | grep -c 'error TS'); printf '{\"systemMessage\": \"TS: %s ошиб(ок) — запусти npx tsc --noEmit\"}' \"$n\"; fi; fi; fi 2>/dev/null || true",
            "timeout": 30,
            "statusMessage": "TypeScript...",
            "async": true
          }
        ]
      }
    ]
  }
}
