#!/bin/bash
# TourHab pre-commit guard — ловит запрещённые паттерны до попадания в репо

ERRORS=0

# printf, а не echo -e: husky зовёт хук через `sh -e`, а в dash `echo -e`
# печатает «-e» и раскрывает \n внутри найденных строк.
red()  { printf '\033[31m%s\033[0m\n' "$*"; }
warn() { printf '\033[33m%s\033[0m\n' "$*"; }

finish() {
  if [ "$ERRORS" -gt 0 ]; then
    red ""
    red "Коммит заблокирован: $ERRORS нарушений стандартов."
    red "Исправь ошибки. Чтобы обойти (с обоснованием): git commit --no-verify"
    exit 1
  fi
  exit 0
}

# ── СЕКРЕТЫ: добавленные строки всех staged-файлов (не только .ts) ─────────
# Шаблоны — один список на хук и CI: scripts/security/secret-scan.mjs (22.10).
# Хук — ранний сигнал, обходится --no-verify; держит правило workflow
# secret-scan.yml на каждом PR и пуше в main. Значение ключа не печатается.
SECRET_SCAN="$(dirname "$0")/../scripts/security/secret-scan.mjs"
if [ -f "$SECRET_SCAN" ]; then
  if ! secret_out=$(node "$SECRET_SCAN" --staged); then
    red "$secret_out"
    ERRORS=$((ERRORS + 1))
  fi
else
  warn "Проверка секретов не выполнена: нет $SECRET_SCAN. Это не «секретов нет»."
fi

# Только изменённые .ts / .tsx файлы кода. Тесты не проверяются: сторож
# запрета держит запрещённое как данные, иначе ему нечего проверять (#2451).
# Секреты выше проверены во ВСЕХ файлах, включая тесты.
CHANGED=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx)$' \
  | grep -vE '(^|/)(tests?|__tests__)/|\.(test|spec)\.tsx?$' || true)
# Без кода — сразу к итогу, а не к выходу с успехом: до 14.10 здесь стоял
# `exit 0`, и найденный секрет в коммите без .ts печатался, но не
# останавливал коммит (#2451).
[ -z "$CHANGED" ] && finish

# Строка-комментарий нарушением не считается: комментарий, объясняющий
# правило, называет запрещённое словами — и останавливал коммит в файл,
# где правило записано (#2451).
check() {
  local pattern="$1"
  local message="$2"
  local matches
  matches=$(echo "$CHANGED" | xargs grep -Hn --include="*.ts" --include="*.tsx" -E "$pattern" 2>/dev/null \
    | grep -vE '^[^:]+:[0-9]+:[[:space:]]*(//|/\*|\*)' \
    | grep -v "node_modules" \
    | grep -v "// allow:" \
    | grep -v "providers\.ts" \
    | grep -v "agent-knowledge\.ts" \
    | grep -v "domainKnowledge" || true)
  if [ -n "$matches" ]; then
    red "ЗАПРЕЩЕНО: $message"
    printf '%s\n' "$matches" | head -5
    ERRORS=$((ERRORS + 1))
  fi
}

# ── SQL: старые таблицы ────────────────────────────────────────
check \
  "FROM\s+bookings\b" \
  "FROM bookings → используй operator_bookings (поле booking_status, не status)"

check \
  "FROM\s+tours\b" \
  "FROM tours → используй operator_tours (или v_kamchatka_routes_api для публичных маршрутов)"

check \
  "SELECT \* FROM kamchatka_routes\b" \
  "SELECT * FROM kamchatka_routes → используй v_kamchatka_routes_api"

# ── SQL: конкатенация строк вместо параметров ─────────────────
check \
  "query\s*\(\s*\`[^']*\\\$\{" \
  "Подозрение на SQL-инъекцию: используй параметры \$1,\$2 вместо \${} в query()"

# ── AI: прямой вызов провайдера мимо водопада ─────────────────
# Ранний сигнал по самой частой форме. Запрет целиком — любой вызов, импорт
# или передача значением вне lib/ai/providers.ts и проб с причиной — держит
# CI: tests/unit/ai-direct-calls.test.ts. Хук обходится --no-verify и в
# облачных сессиях не установлен, поэтому судья — CI, а хук лишь
# предупреждает раньше (#2451). callMiMo удалена переписью блока D.
check \
  "await (callDeepSeek|callOpenrouter)\b" \
  "прямой вызов провайдера → callAIWaterfall() или callAIFast(). Проба провайдера — запись в PROBES (tests/unit/ai-direct-calls.test.ts) и // allow: в строке"

# ── Импорты ───────────────────────────────────────────────────
check \
  "import pool from" \
  "import pool from → используй: import { pool } from '@/lib/db-pool'"

# ── Устаревшие токены ─────────────────────────────────────────
# Стекло (backdrop-blur-*, bg-white/10) хук не запрещает: решение владельца
# 26.09 — поверх фото и карт стекло законно, а сплошной ли под ним фон, по
# тексту файла не видно. Прежний запрет останавливал коммит в любой файл со
# стеклом, включая карточку тура и страницу перевозчика (#2451).
check \
  "text-cyber-cyan|text-premium-gold|bg-premium-" \
  "Устаревшие токены (cyber-cyan, premium-*) → токены дизайн-системы, CLAUDE.md §2"

check \
  "console\.log\b" \
  "console.log в продакшн-коде — удали или замени на структурированный лог"

# ── Итог ──────────────────────────────────────────────────────
finish
